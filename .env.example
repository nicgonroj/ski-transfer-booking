# ──────────────────────────────────────────────────────────────
# Copiar a .env.local y completar. Sin estas variables el sitio
# corre en MODO MOCK (reservas en memoria, admin con login de demo).
# ──────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
# Formato: https://<project-ref>.<dominio-de-supabase>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (sitemap, robots, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagos (opcional; solo si pagos.proveedor != 'link_manual')
MERCADOPAGO_ACCESS_TOKEN=
FLOW_API_KEY=
FLOW_SECRET_KEY=
